OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Visual analysis (Phase 1 deterministic render audit)
# Set to 1 to disable visual analysis if Playwright is unavailable
DISABLE_VISUAL_ANALYSIS=0

# Supabase persistence (roast reports + analytics events)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private office integration
# Must match WEB_ROAST_API_SECRET in lockdown-office-secure
OFFICE_ROAST_API_SECRET=

# Paystack billing
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Admin protection for /analytics and /api/track/summary
ADMIN_DASH_USER=
ADMIN_DASH_PASSWORD=
