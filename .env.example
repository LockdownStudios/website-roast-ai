OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-terra
# Direct provider selection. No automatic cross-provider fallback.
ROAST_AI_PROVIDER=openai
DEEPSEEK_API_KEY=
# For direct DeepSeek use: ROAST_AI_PROVIDER=deepseek,
# ROAST_AI_MODEL=deepseek-flash and ROAST_AI_ALLOWED_MODELS=deepseek-flash.
# New generation uses ROAST_AI_MODEL, not the legacy OPENAI_MODEL value.
# Apply 20261015_ai_usage_limits.sql in Roast AI Supabase before enabling.
ROAST_AI_ENABLED=0
ROAST_AI_ALLOW_LOCAL=0
ROAST_AI_MODEL=gpt-5.6-terra
ROAST_AI_ALLOWED_MODELS=gpt-5.6-terra
# Estimated maximum for BOTH text calls at approved standard uncached rates.
# Unknown OpenAI models are blocked; this is not an account-wide billing limit.
ROAST_AI_MAX_RUN_USD=0.10
ROAST_USER_DAILY_LIMIT=3
# Authenticated Office scans are metered without daily quotas or cooldowns.
ROAST_GLOBAL_DAILY_LIMIT=20
# Conservative input-byte + output-token reservations, NOT Rand/dollar budgets.
ROAST_AI_DAILY_BUDGET_UNITS=1000000
ROAST_AI_MONTHLY_BUDGET_UNITS=10000000
ROAST_AI_MAX_INPUT_BYTES=65000
ROAST_AI_WRITER_MAX_TOKENS=4000
ROAST_AI_REVIEW_MAX_TOKENS=800
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Visual analysis (Phase 1 deterministic render audit)
# Set to 1 to disable visual analysis if Playwright is unavailable
DISABLE_VISUAL_ANALYSIS=0

# Supabase persistence (roast reports + analytics events)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional durable scan queue. Apply supabase/migrations/20260915_roast_scan_jobs.sql first.
# A protected scheduler must POST to /api/internal/scan-worker with this value as a Bearer token.
ROAST_ASYNC_JOBS=0
ROAST_JOB_WORKER_SECRET=
# For Vercel Cron. Vercel sends this value as a Bearer token to the worker route.
CRON_SECRET=

# Private office integration
# V2 is an internal preview. Apply 20261030_durable_scans_v2.sql first.
ROAST_V2_ENABLED=0
ROAST_V2_PUBLIC_ENABLED=0
ROAST_V2_AI_ENABLED=0
# Standalone workers default to pagespeed. npm run dev:scanner selects local.
# local runs genuine Lighthouse in isolated Chromium, without PageSpeed API quota.
ROAST_V2_MEASUREMENT_PROVIDER=pagespeed
PAGESPEED_API_KEY=
# Must match WEB_ROAST_API_SECRET in lockdown-office-secure
OFFICE_ROAST_API_SECRET=

# Paystack billing
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Admin protection for /analytics and /api/track/summary
ADMIN_DASH_USER=
ADMIN_DASH_PASSWORD=
