{
  "name": "web-roast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:benchmark": "tsx -e \"import { runBenchmarkSuite } from './lib/benchmark.ts'; const result = runBenchmarkSuite(); console.log(JSON.stringify(result.summary, null, 2)); if (!result.summary.overallPass) process.exit(1);\"",
    "test:phase-one": "node --conditions react-server --import tsx scripts/verify-phase-one.ts",
    "test:crawl": "node --conditions react-server --import tsx scripts/verify-crawl-coverage.ts",
    "test:profile": "node --conditions react-server --import tsx scripts/verify-business-profile.ts",
    "test:claims": "node --conditions react-server --import tsx scripts/verify-claim-contract.ts",
    "test:reports": "node --conditions react-server --import tsx scripts/verify-report-fixture.ts",
    "test:quality": "node --conditions react-server --import tsx scripts/verify-report-quality.ts",
    "test:journeys": "node --conditions react-server --import tsx scripts/verify-journey-scoring.ts",
    "test:ai-usage": "node --conditions react-server --import tsx scripts/verify-ai-usage.ts",
    "test:evidence-packing": "node --conditions react-server --import tsx scripts/verify-compact-evidence.ts",
    "test:ai-provider": "node --conditions react-server --import tsx scripts/verify-ai-provider.ts",
    "test:visual-readiness": "node --conditions react-server --import tsx scripts/verify-visual-readiness.ts",
    "test:crawl-selection": "node --conditions react-server --import tsx scripts/verify-crawl-selection.ts",
    "ci": "npm run typecheck && npm run lint && npm run test:product-cta && npm run test:evidence-hardening && npm run test:refinements && npm run test:presentation && npm run test:compact-report && npm run test:technical && npm run test:outreach && npm run test:request-budget && npm run test:ai-usage && npm run test:evidence-packing && npm run test:ai-provider && npm run test:benchmark && npm run test:phase-one && npm run test:crawl && npm run test:crawl-selection && npm run test:profile && npm run test:claims && npm run test:quality && npm run test:journeys && npm run test:visual-readiness && npm run test:reports && npm audit --audit-level=high && npm run build",
    "test:outreach": "node --conditions react-server --import tsx scripts/verify-outreach.ts",
    "test:technical": "node --conditions react-server --import tsx scripts/verify-technical-audit.ts",
    "test:compact-report": "node --conditions react-server --import tsx scripts/verify-compact-report.ts",
    "test:refinements": "node --conditions react-server --import tsx scripts/verify-refinements.ts",
    "test:evidence-hardening": "node --conditions react-server --import tsx scripts/verify-evidence-hardening.ts",
    "test:product-cta": "node --conditions react-server --import tsx scripts/verify-product-cta.ts",
    "test:request-budget": "node --conditions react-server --import tsx scripts/verify-request-budget.ts",
    "test:presentation": "node --conditions react-server --import tsx scripts/verify-report-presentation.ts"
  },
  "dependencies": {
    "@sparticuz/chromium": "147.0.2",
    "next": "^16.4.3",
    "pdfkit": "^0.20.1",
    "playwright": "^1.59.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
